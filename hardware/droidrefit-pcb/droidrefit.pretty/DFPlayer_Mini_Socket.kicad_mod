(footprint "DFPlayer_Mini_Socket"
  (version 20241229)
  (generator "kicad-mcp")
  (generator_version "9.0")
  (layer "F.Cu")
  (descr "DFPlayer Mini on 2x 1x8 female sockets. Module body ~20.2 x 20.2 mm (square). Pins: 2.54mm pitch, 8 per row, 15.24mm (0.6in) row spacing - the 15.24 x 17.78mm pin field sits inside the 20.2mm square board. Pads 1-8 = left edge top-to-bottom (VCC at top), 9-16 = right edge counter-clockwise (BUSY pin16 top-right, IO_1 pin9 bottom-right). microSD card slot is on the pin 8/9 (SPK/DAC) end - card enters from that short edge (~4mm overhang). Keep that edge accessible. Verified against user photo 2026-08-30.")
  (tags "DFPlayer mini mp3 socket")

